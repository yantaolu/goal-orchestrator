{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/goal-orchestrator/role.schema.json",
  "title": "Goal Implementation Simulation Role",
  "description": "A capability-derived, lifecycle-accountable role used to develop and validate a reality-ready implementation guide without external execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role_id",
    "name",
    "role_type",
    "mission",
    "lifecycle",
    "lifecycle_stages",
    "contribution_modes",
    "activation_conditions",
    "deactivation_conditions",
    "responsibilities",
    "capability_ids",
    "subgoal_ids",
    "inputs",
    "expected_outputs",
    "dependencies",
    "collaboration_targets",
    "decision_rights",
    "simulation_actions",
    "forbidden_real_actions",
    "constraints",
    "success_criteria",
    "assumptions",
    "confidence"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "role_id": {
      "type": "string",
      "pattern": "^R(0|[1-9][0-9]*)$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "role_type": {
      "type": "string",
      "enum": [
        "orchestrator",
        "specialist",
        "integrator",
        "evaluator",
        "challenger"
      ]
    },
    "mission": {
      "type": "string",
      "minLength": 10
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "persistent",
        "phase-bound",
        "on-demand"
      ]
    },
    "lifecycle_stages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "understand",
          "plan",
          "design",
          "produce",
          "validate",
          "integrate",
          "deliver",
          "operate",
          "learn"
        ]
      }
    },
    "contribution_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "coordinate",
          "decide",
          "design",
          "produce",
          "validate",
          "integrate",
          "deliver",
          "operate",
          "challenge"
        ]
      }
    },
    "activation_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deactivation_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "responsibilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "capability_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CAP[1-9][0-9]*$"
      }
    },
    "subgoal_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SG[1-9][0-9]*$"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input_id",
          "description",
          "provider_ids",
          "acceptance_criteria"
        ],
        "properties": {
          "input_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 3
          },
          "provider_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(R(0|[1-9][0-9]*)|USER|SIMULATION)$"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          }
        }
      }
    },
    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "name",
          "description",
          "lifecycle_stage",
          "contribution_mode",
          "consumer_ids",
          "acceptance_criteria",
          "independent_validator_ids",
          "real_world_checks_unperformed",
          "created_in_simulation"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^ART[1-9][0-9]*$"
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "description": {
            "type": "string",
            "minLength": 3
          },
          "lifecycle_stage": {
            "type": "string",
            "enum": [
              "understand",
              "plan",
              "design",
              "produce",
              "validate",
              "integrate",
              "deliver",
              "operate",
              "learn"
            ]
          },
          "contribution_mode": {
            "type": "string",
            "enum": [
              "coordinate",
              "decide",
              "design",
              "produce",
              "validate",
              "integrate",
              "deliver",
              "operate",
              "challenge"
            ]
          },
          "consumer_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(R(0|[1-9][0-9]*)|FINAL)$"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "independent_validator_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^R[1-9][0-9]*$"
            }
          },
          "real_world_checks_unperformed": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "created_in_simulation": {
            "const": true
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_ids",
        "artifact_ids"
      ],
      "properties": {
        "role_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^R(0|[1-9][0-9]*)$"
          }
        },
        "artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ART[1-9][0-9]*$"
          }
        }
      }
    },
    "collaboration_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role_id",
          "purpose",
          "cadence",
          "artifact_ids"
        ],
        "properties": {
          "role_id": {
            "type": "string",
            "pattern": "^R(0|[1-9][0-9]*)$"
          },
          "purpose": {
            "type": "string",
            "minLength": 3
          },
          "cadence": {
            "type": "string",
            "enum": [
              "per-handoff",
              "per-round",
              "at-gate",
              "on-exception"
            ]
          },
          "artifact_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^ART[1-9][0-9]*$"
            }
          }
        }
      }
    },
    "decision_rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "can_decide",
        "must_consult",
        "must_escalate"
      ],
      "properties": {
        "can_decide": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "must_consult": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "must_escalate": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "simulation_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "forbidden_real_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "indicator",
          "target",
          "evidence_source"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 3
          },
          "indicator": {
            "type": "string",
            "minLength": 3
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "evidence_source": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^A[1-9][0-9]*: .+$"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
